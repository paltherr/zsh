  local cmd X
  for cmd in "break" "continue"; do
    echo "Testing \"$cmd\":"
    for X in A B; do
      (
        echo "$cmd: $X before"
        $cmd 2>&1;
        echo "$cmd: $X after1"
      )
      echo "$cmd: $X after2"
    done
  done
