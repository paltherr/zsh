  local cmd X
  for cmd in "break 1" "break 2" "break 3" "continue 1" "continue 2" "continue 3"; do
    echo "Testing \"$cmd\":"
    for X in A; do
      (
        for Y in p q; do
          for Z in 1 2; do
            echo "$cmd: $X$Y$Z before"
            eval $cmd 2>&1
            echo "$cmd: $X$Y$Z after"
          done
          echo "$cmd: $X$Y- after"
        done
        echo "$cmd: $X-- after1"
      )
      echo "$cmd: $X-- after2"
    done
  done
