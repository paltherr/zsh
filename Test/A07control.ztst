# Test control commands for loops and functions.

%test

  fn3() { return $1; print Error }
  fn2() { fn3 $1 }
  fn() {
    print start $1
    fn2 $1
    return
    print Error
  }
  for val in -1 0 1 255; do
    fn $val; print $?
  done
0:Passing of return values back through functions
>start -1
>-1
>start 0
>0
>start 1
>1
>start 255
>255

  $ZTST_testdir/../Src/zsh -fc 'fn() {
    break
  }
  fn'
1:break outside loop
?fn:break:1: not in for, while, until, select, or repeat loop

  $ZTST_testdir/../Src/zsh -fc 'fn() {
    continue
  }
  fn'
1:continue outside loop
?fn:continue:1: not in for, while, until, select, or repeat loop

  local cmd script=()
  for cmd in "break 2" "break 3" "break 4" "continue 2" "continue 3" "continue 4"; do
    script+='
      echo "Testing \"'$cmd'\":"
      for X in A B; do
        for Y in p q; do
          for Z in 1 2; do
            echo "'$cmd': $X$Y$Z before"
            '$cmd' 2>&1
            echo "'$cmd': $X$Y$Z after"
          done
          echo "'$cmd': $X$Y- after"
        done
        echo "'$cmd': $X-- after"
      done
      echo "'$cmd': --- after"
    '
  done
  $ZTST_testdir/../Src/zsh -fc "$script"
